# Copy this file to .env and fill it in. NEVER commit .env to git.
PORT=5000

# The URL of your Next.js site (CORS). Use commas for several URLs.
CORS_ORIGIN=http://localhost:3000

# Firebase Admin credentials:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Either point to the downloaded JSON file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# ...or (for hosting) use these three values from that JSON instead:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
